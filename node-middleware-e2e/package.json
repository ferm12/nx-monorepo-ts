{
  "name": "@apps/node-middleware-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@apps/node-middleware"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "node-middleware-e2e/jest.config.ts",
          "passWithNoTests": true
        },
        "dependsOn": [
          "@apps/node-middleware:build",
          "@apps/node-middleware:serve"
        ]
      }
    }
  }
}
